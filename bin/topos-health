#!/bin/sh
# topos-health — the SessionStart hook (Claude Code). Prints at most ONE line,
# which Claude Code adds to the session as context, and exits 0 within ~1.3 s.
#
#   topos-health --client claude-code
#
# It starts `topos-node status --json` in the background, writing into the
# plugin's data directory, waits up to 1.2 s for it, and reads the result:
#   not running   → Topos isn't running — say "start Topos".
#   not paired    → Topos isn't connected to your account yet — say "set up Topos".
#   agent missing → This agent isn't connected to Topos yet — say "set up Topos".
#   outdated      → Topos is out of date — say "update Topos".
#   all good      → nothing (no noise every session)
# If status has not answered in time the hook says nothing; the background job
# still finishes and the next session reads it. Nothing here is a secret:
# `status --json` carries none by contract (CONTRACTS.md §4).
set -u
# PATH may be EMPTY here (GUI-launched hosts, spike P0.5): no external command
# before this line; the directory comes from parameter expansion + cd/pwd builtins.
PATH="/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"; export PATH
case "$0" in */*) here=$(CDPATH= cd -- "${0%/*}" && pwd) ;; *) here=$(pwd) ;; esac
. "$here/../lib/resolve.sh"
topos_sane_path

CLIENT=$(topos_arg_client "$@")
[ -n "$CLIENT" ] || CLIENT=claude-code

NODE=$(topos_resolve_node "$0") || {
    printf '%s\n' 'Topos isn'"'"'t set up on this computer yet — say "set up Topos".'
    exit 0
}
PY=$(topos_python) || exit 0

DATA_DIR=${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/topos-plugin}
mkdir -p "$DATA_DIR" 2>/dev/null || exit 0
chmod 700 "$DATA_DIR" 2>/dev/null
TMP="$DATA_DIR/status.$$.tmp"
DONE="$DATA_DIR/status.json"

# Create the temp file now, so the poll below never races the background job's
# own redirect (observed: the poll saw no TMP, read no DONE, and said nothing).
: > "$TMP" 2>/dev/null || exit 0
(
    "$NODE" status --json </dev/null >"$TMP" 2>/dev/null
    mv -f "$TMP" "$DONE" 2>/dev/null
) >/dev/null 2>&1 &

tick=0
while [ -e "$TMP" ] && [ "$tick" -lt 10 ]; do
    sleep 0.1
    tick=$((tick + 1))
done
[ -e "$TMP" ] && exit 0        # still running: say nothing this time
[ -s "$DONE" ] || exit 0

"$PY" -I - "$DONE" "$CLIENT" <<'PY' 2>/dev/null
import json, sys
try:
    s = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    sys.exit(0)
client = sys.argv[2]
if not isinstance(s, dict):
    sys.exit(0)
node = s.get("node") if isinstance(s.get("node"), dict) else {}
if node.get("running") is False:
    print("Topos isn't running — say \"start Topos\"."); sys.exit(0)
if s.get("paired") is False:
    print("Topos isn't connected to your account yet — say \"set up Topos\"."); sys.exit(0)
agents = s.get("agents") if isinstance(s.get("agents"), list) else []
mine = [a for a in agents if isinstance(a, dict) and a.get("client") == client and not a.get("revoked")]
if not mine:
    print("This agent isn't connected to Topos yet — say \"set up Topos\"."); sys.exit(0)
if s.get("outdated") is True:
    print('Topos is out of date — say "update Topos".'); sys.exit(0)
PY
exit 0
